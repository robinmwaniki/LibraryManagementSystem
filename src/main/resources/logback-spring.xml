<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="LibraryManagementSystem"/>
    <springProperty scope="context" name="applicationEnvironment" source="SENTRY_ENVIRONMENT" defaultValue="local"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${applicationName}","environment":"${applicationEnvironment}"}</customFields>
        </encoder>
    </appender>

    <logger name="com.example.librarymanagementsystem" level="${APP_LOG_LEVEL:-INFO}"/>
    <root level="${ROOT_LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
