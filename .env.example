# Copy this file to .env and replace the passwords before starting Docker Compose.
POSTGRES_DB=library_db
POSTGRES_USER=library
DB_PASSWORD=replace-with-a-strong-database-password
LIBRARY_ADMIN_USERNAME=admin
LIBRARY_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Optional SMTP settings (leave notifications disabled until tested).
LIBRARY_NOTIFICATIONS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional Sentry error reporting. Leave DSN blank to disable telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=library-management-system@local
SENTRY_ERROR_SAMPLE_RATE=1.0
# Performance tracing is disabled by default to conserve the free-tier quota.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Enable only temporarily when testing Sentry delivery; requires an administrator login.
LIBRARY_OBSERVABILITY_TEST_ENDPOINT_ENABLED=false
